DATABASE_URL=postgresql+psycopg://penn:penn@localhost:5432/pennevents
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=America/New_York
MAX_CONCURRENT_FEEDERS=8
# PENN_CONFIG_PATH=/app/penn_events/config/master.yaml
# PENN_TAG_RULES_PATH=/app/penn_events/config/tag_rules.yaml

# Password for the PostgREST "authenticator" Postgres role (see
# alembic/versions/0002_api_schema.py and the postgrest service in
# docker-compose.yml). This is a local-dev placeholder, same as the
# penn/penn DB credentials above -- rotate it for any real deployment.
POSTGREST_AUTHENTICATOR_PASSWORD=postgrest_dev_password
