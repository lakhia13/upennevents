DATABASE_URL=postgresql+psycopg://penn:penn@localhost:5432/pennevents
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=America/New_York
MAX_CONCURRENT_FEEDERS=8
# PENN_CONFIG_PATH=/app/penn_events/config/master.yaml
# PENN_TAG_RULES_PATH=/app/penn_events/config/tag_rules.yaml

# Which kind of Postgres the Alembic chain is talking to: "local" (default) or
# "supabase". On a managed platform the roles `authenticator` and `anon` already
# exist and belong to the platform, so migration 0002 must create nothing and
# grant to `anon` -- rewriting the authenticator password there would take the
# hosted API offline. Leave unset for docker-compose; the migration aborts with
# a clear message rather than guess if it sees a managed cluster without it.
# See penn_events/db/deploy_target.py.
# DB_TARGET=supabase

# Password for the PostgREST "authenticator" Postgres role (see
# alembic/versions/0002_api_schema.py and the postgrest service in
# docker-compose.yml). Local dev only -- with DB_TARGET=supabase this is never
# read, because Supabase manages that role's credentials itself.
POSTGREST_AUTHENTICATOR_PASSWORD=postgrest_dev_password
