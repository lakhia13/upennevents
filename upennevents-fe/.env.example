# Base URL of the PostgREST API.
#
# Local dev: the docker-compose "postgrest" service (see ../docker-compose.yml).
VITE_POSTGREST_URL=http://localhost:3001
#
# Production: Supabase's REST endpoint, which is PostgREST too -- same query
# syntax, same api.events view, so nothing else changes.
# VITE_POSTGREST_URL=https://<project-ref>.supabase.co/rest/v1

# Supabase project anon key. Required by Supabase on every request; leave unset
# for a self-hosted PostgREST, which needs no key.
#
# This key is meant to be public and ships in the built bundle. What protects the
# data is server-side: only the `api` schema is exposed (Supabase -> Settings ->
# API -> Exposed schemas), and the raw tables are RLS-denied by
# alembic/versions/0004_rls_lockdown.py. Never put the service_role key here --
# that one bypasses both.
# VITE_SUPABASE_ANON_KEY=<anon key from Supabase -> Settings -> API>
